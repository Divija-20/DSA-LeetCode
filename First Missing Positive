class Solution {
    public int firstMissingPositive(int[] nums) {
       int n = nums.length;
       for (int i = 0; i < n;) {
        int correct = nums[i] - 1;
        if (nums[i] > 0 && nums[i] <= n && nums[i] != nums[correct]) {
          int tmp = nums[i];
          nums[i] = nums[correct];
          nums[correct] = tmp;
        } else {
        i++;
       }
    }
    for (int i = 0; i < n; i++) {
        if (nums[i] != i + 1) return i + 1;
    }
    return n + 1;   
    }
}
