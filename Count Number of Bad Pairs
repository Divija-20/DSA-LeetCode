class Solution {
    public long countBadPairs(int[] nums) {
      Map<Integer, Integer> freq = new HashMap<>();
      long goodPairs = 0;
      int n = nums.length;

      for (int i = 0; i < n; i++) {
        int diff = nums[i] - i;
        int count = freq.getOrDefault(diff, 0);
        goodPairs += count;
        freq.put(diff, count + 1);
      }
      long totalPairs = (long) n * (n - 1) / 2;
      return totalPairs - goodPairs;  
    }
}
